{
  "name": "@local/article-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "导入 Markdown、Word、PDF，预览全文，输出知乎文章和 X 推文串，使用本地模型配图。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core.js",
    "image-worker.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "vendor",
    "README.md",
    "publisher.js",
    "client-src.js",
    "core.test.mjs",
    "document-import.js",
    "zhihu-cover.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.63.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "twitter-text": "^3.1.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkgy/dsh-article-share.git"
  },
  "scripts": {
    "test": "node --test core.test.mjs document-import.test.mjs zhihu-cover.test.mjs",
    "build": "esbuild client-src.js --bundle --format=iife --platform=browser --target=chrome120 --outfile=client.js --minify"
  }
}
